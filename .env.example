# Email RAG System Configuration
# Copy this to .env and fill in the values for your chosen providers.

# -----------------------------
# LLM configuration (optional)
# -----------------------------
# Only required when running RAG generation (engine.query).
# Not required for indexing-only workflows.

# LLM Provider: "openai", "perplexity", or "lmstudio"
# RAG_LLM_PROVIDER=openai

# LLM model (depends on provider)
# RAG_LLM_MODEL=gpt-3.5-turbo

# LLM temperature (0.0-1.0 typical)
# RAG_LLM_TEMPERATURE=0.7

# OpenAI key (required if RAG_LLM_PROVIDER=openai OR RAG_EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here

# Perplexity key (required if RAG_LLM_PROVIDER=perplexity)
# PERPLEXITY_API_KEY=pplx-your-key-here

# LM Studio LLM (used when RAG_LLM_PROVIDER=lmstudio)
# OpenAI-compatible base URL — use host.docker.internal inside a devcontainer
# RAG_LLM_PROVIDER=lmstudio
# RAG_LLM_API_BASE=http://host.docker.internal:1234/v1
# RAG_LLM_MODEL=mistralai/magistral-small-2509
# RAG_LLM_API_KEY=sk-lm-...   # LM Studio API token (Developer -> API token); required when LM Studio auth is enabled

# ---------------------------------
# Embedding provider configuration
# ---------------------------------
# Embedding Provider: "openai" or "lmstudio"
RAG_EMBEDDING_PROVIDER=lmstudio

# Embedding model name
RAG_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# OpenAI-compatible embedding endpoint
# - OpenAI mode: usually keep default https://api.openai.com/v1
# - LM Studio mode in devcontainer: http://host.docker.internal:1234/v1
RAG_EMBEDDING_API_BASE=http://host.docker.internal:1234/v1

# Optional key for OpenAI-compatible embedding endpoint (often empty for LM Studio)
RAG_EMBEDDING_API_KEY=

# Optional indexing throughput tuning
# RAG_INDEX_BATCH_SIZE=200
# RAG_DOWNLOAD_WORKERS=8
# RAG_EMBEDDING_BATCH_SIZE=512   # texts per request to LM Studio (512 recommended for M-series; reduce if LM Studio crashes)
# RAG_EMBEDDING_NUM_WORKERS=1    # keep at 1: single async worker sends one large batch, waits for GPU, then sends next
                                  # values > 1 spawn multiple processes that flood the LM Studio queue faster than the GPU clears it
# RAG_EMBEDDING_TIMEOUT=1800     # HTTP read timeout in seconds for embedding requests (default 1800 = 30 min)
                                  # covers LM Studio cold-start (loading a large model into VRAM can take 5-10 min)

# Chunking parameters
# RAG_CHUNK_SIZE=1024
# RAG_CHUNK_OVERLAP=20

# Storage directory for local "simple" provider
# STORAGE_DIR=./storage

# ---------------------------------
# Azure Blob storage (.eml source)
# ---------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_BLOB_CONTAINER=eml-archive
# Optional prefix to scope blob listing (e.g., Inbox/)
AZURE_BLOB_PREFIX=

# ---------------------------------
# Vector store configuration
# ---------------------------------
# Provider: "simple" (local), "qdrant", or "pinecone"
VECTOR_STORE_PROVIDER=qdrant

# Qdrant — the default quickstart runs a LOCAL Qdrant via `docker compose up -d qdrant`.
QDRANT_URL=http://localhost:6333
# For a managed/cloud Qdrant instead, point this at it (and set the API key):
#   QDRANT_URL=https://xxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
# The default quickstart builds the thread-aware CONTEXTUAL stack:
#   bge-m3 hybrid embeddings (FlagEmbedding, local) + per-email preceding-context
#   summaries + thread-aware retrieval. An LLM key/endpoint (above) is required for
#   the Pass-2 summaries and the answers. Qdrant runs via `docker compose up -d qdrant`.
QDRANT_COLLECTION_NAME=mailrag-demo
# REST (6333) is all the local docker-compose exposes; gRPC needs port 6334 published.
QDRANT_PREFER_GRPC=false
# Host path for the local Docker Qdrant bind-mount (docker-compose.yml).
# Point this at an existing storage dir to reuse its data; defaults to ./qdrant_storage.
QDRANT_STORAGE_PATH=./qdrant_storage

# Pinecone (optional legacy path)
# PINECONE_API_KEY=your-key-here
# PINECONE_INDEX_NAME=email-rag
