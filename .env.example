# Email RAG System Configuration
# Copy this to .env and fill in the values for your chosen providers.

# -----------------------------
# LLM configuration (optional)
# -----------------------------
# Needed for answers (`mailrag ask`, MCP answer_question), the AI recipe steps
# (calibrate/judge/summarize) and vision OCR of attachments. Not needed for
# `just demo`, `just bench` or the "Quick, no AI" recipe.
# Every LLM call goes through one OpenAI-compatible client (src/llm/client.py).
# The base URL alone picks the server. See docs/BACKENDS.md for per-backend values.

# OpenAI-compatible base URL (default http://localhost:1234/v1, LM Studio).
# Use host.docker.internal inside a devcontainer.
# RAG_LLM_API_BASE=http://host.docker.internal:1234/v1

# Model id as the endpoint names it. Required for any LLM step. No default.
# RAG_LLM_MODEL=mistralai/magistral-small-2509

# Endpoint key. Optional for auth-less local servers. Accepts a keychain:/env:/file:
# reference so the token need not sit in this file.
# RAG_LLM_API_KEY=sk-lm-...   # LM Studio API token (Developer -> API token); required when LM Studio auth is enabled

# ---------------------------------
# Legacy embedding configuration
# ---------------------------------
# Read only by two legacy scripts (scripts/reset_qdrant_index.py,
# scripts/smoke_lmstudio_embedding.py). The CLI, `just demo` and the MCP server
# embed with local bge-m3 and ignore these.
# RAG_EMBEDDING_PROVIDER=lmstudio          # "openai" or "lmstudio"
# RAG_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# RAG_EMBEDDING_API_BASE=http://host.docker.internal:1234/v1
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_BATCH_SIZE=512
# RAG_EMBEDDING_NUM_WORKERS=1
# RAG_EMBEDDING_TIMEOUT=1800               # HTTP read timeout in seconds

# Chunk size and overlap for your own mail live in the corpus profile
# (`mailrag measure`), not in environment variables.

# ---------------------------------
# Vector store configuration
# ---------------------------------
# Qdrant is the only backend — there is no provider switch. See docs/ROADMAP.md
# for why (the learned-sparse-alongside-dense seam retrieval depends on is
# Qdrant-specific).
#
# Qdrant — the default quickstart runs a LOCAL Qdrant via `docker compose up -d qdrant`.
QDRANT_URL=http://localhost:6333
# For a managed/cloud Qdrant instead, point this at it (and set the API key):
#   QDRANT_URL=https://xxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
# Read only by legacy scripts. The CLI takes --collection or the profile's collection.
# QDRANT_COLLECTION_NAME=mailrag-demo
# REST (6333) is all the local docker-compose exposes; gRPC needs port 6334 published.
QDRANT_PREFER_GRPC=false
# Host path for the local Docker Qdrant bind-mount (docker-compose.yml).
# Point this at an existing storage dir to reuse its data; defaults to ./qdrant_storage.
QDRANT_STORAGE_PATH=./qdrant_storage
